{
  "manifest_version": 3,
  "name": "Redactor",
  "version": "0.1.0",
  "description": "Redacts a list of keywords from any page as it renders.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "css": ["src/redact.css"],
      "js": ["src/config.js", "src/engine.js", "src/content.js"]
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Redactor"
  }
}
